# Copie este arquivo para .env.local (desenvolvimento) ou cole as variáveis na Vercel
# (Settings → Environment Variables). Nunca publique chaves reais no repositório.

# --- Sanity (posts) ---
# ID do projeto em sanity.io/manage. Vazio = o blog mostra os posts de exemplo de content/sample-posts.js.
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Dataset onde estão os posts (o padrão do Sanity é "production"). Ele precisa ser público (o padrão).
NEXT_PUBLIC_SANITY_DATASET=production
# Segredo do webhook que atualiza o site na hora em que você publica (opcional; veja o README).
# Sem ele, as páginas se atualizam sozinhas em até 1 minuto.
SANITY_REVALIDATE_SECRET=

# Provedor que recebe os e-mails da newsletter do blog: kit | mailchimp | brevo | none
# "none" (padrão): nada é enviado ou guardado; o formulário só mostra o aviso de exemplo.
# Um nome diferente desses quatro é tratado como erro de configuração (o formulário mostra "Não deu certo agora").
EMAIL_PROVIDER=none

# --- Kit (ConvertKit) --- usado quando EMAIL_PROVIDER=kit
# Chave da API v4 (Kit -> Settings -> Developer).
KIT_API_KEY=
# ID numérico do formulário onde os inscritos entram.
KIT_FORM_ID=

# --- Mailchimp --- usado quando EMAIL_PROVIDER=mailchimp
# Chave da API, no formato xxxxxxxx-us21 (o sufixo indica o servidor).
MAILCHIMP_API_KEY=
# ID da audiência (lista).
MAILCHIMP_LIST_ID=
# true = o inscrito confirma por e-mail antes de entrar (double opt-in); qualquer outro valor = entra direto.
MAILCHIMP_DOUBLE_OPTIN=false

# --- Brevo --- usado quando EMAIL_PROVIDER=brevo
# Chave da API v3.
BREVO_API_KEY=
# ID numérico da lista de contatos.
BREVO_LIST_ID=

# --- Links para as outras páginas (rodapé). Vazio = endereços padrão na Vercel. ---
NEXT_PUBLIC_URL_CURSO=
NEXT_PUBLIC_URL_CONSULTORIA=
NEXT_PUBLIC_URL_IA_DO_ZERO=
NEXT_PUBLIC_URL_BIO=

# Endereço público do blog, usado nas prévias de link, no RSS e no sitemap.
# Na Vercel não precisa: o endereço de produção é usado sozinho. Preencha quando tiver um domínio próprio.
# Exemplo: https://blog.seudominio.com
NEXT_PUBLIC_SITE_URL=
